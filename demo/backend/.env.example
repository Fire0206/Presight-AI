# Fill in the full JSON endpoint URL and credentials from your provider.
FUND_MARKET_API_URL=
FUND_MARKET_API_KEY=
FUND_MARKET_API_KEY_HEADER=Authorization
FUND_MARKET_API_AUTH_SCHEME=Bearer

STOCK_MARKET_API_URL=
STOCK_MARKET_API_KEY=
STOCK_MARKET_API_KEY_HEADER=Authorization
STOCK_MARKET_API_AUTH_SCHEME=Bearer

# Optional OpenAI-compatible chat completion endpoint for local testing only.
# Keep the API key in this backend-only .env file; never place it in frontend code.
# The endpoint and model identifier are fixed by the local operator, not user input.
MODEL_CHAT_ENABLED=false
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=512
MODEL_TIMEOUT_SECONDS=30
